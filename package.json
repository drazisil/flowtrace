{
  "name": "flowtrace",
  "version": "0.1.0",
  "description": "Run a Node program and get a timeline tree of the code flow. No source changes: functions are wrapped at load time.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Molly Draven",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drazisil/flowtrace.git"
  },
  "bugs": "https://github.com/drazisil/flowtrace/issues",
  "homepage": "https://github.com/drazisil/flowtrace#readme",
  "keywords": ["tracing", "debugging", "call-tree", "esm", "loader", "nodejs"],
  "engines": {
    "node": ">=20.6"
  },
  "exports": {
    "./register": "./register.mjs"
  },
  "files": [
    "register.mjs",
    "hooks.mjs",
    "runtime.mjs",
    "transform.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "acorn": "^8.19.0",
    "magic-string": "^1.4.3"
  },
  "scripts": {
    "test": "node --test"
  }
}
